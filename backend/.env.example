# On your own computer: copy this file to .env and change the values.
# On Railway: add the same names under the service's Variables tab instead (no .env file is needed).

# Organiser (admin) login. CHANGE THE PASSWORD before sharing the link.
ADMIN_USER=admin
ADMIN_PASS=admin123

# Set to 1 on Railway (and behind any other proxy), so each visitor's own address is seen.
# TRUST_PROXY=1

# Port the server runs on. Railway sets this by itself; leave it out there.
PORT=8170

# MongoDB. Leave it out on your own computer to use the MongoDB running there (database "jobfair").
# On Railway, add a MongoDB service: its MONGO_URL is picked up by itself.
# MONGODB_URI=mongodb://127.0.0.1:27017/jobfair

# Where the uploaded resumes are kept. Not needed on Railway when a volume is attached
# (the volume is found by itself), and not needed on your own computer (the data folder here is used).
# DATA_DIR=/data

# Optional: a long random text used to sign logins. If left out, one is created and stored in the database.
# JWT_SECRET=

# Optional: only let these website addresses use the server (comma separated). Empty means any address.
# CORS_ORIGIN=https://your-site.vercel.app
